# Maintainer: vw6 <19575067+vw6 at users dot noreply dot github dot com>
pkgname=keepup
pkgver=0.1.0
pkgrel=1
pkgdesc="GNOME-style updates, versions and rollbacks for Arch, AUR and Flatpak"
arch=('any')
url="https://github.com/vw6/keepup"
license=('GPL-3.0-or-later')
# libadwaita 1.7: Adw.ToggleGroup; GTK 4.10: Gtk.UriLauncher; checkupdates из pacman-contrib; pkexec из polkit.
depends=('python>=3.10' 'python-gobject' 'gtk4>=1:4.10' 'libadwaita>=1:1.7' 'pacman' 'pacman-contrib' 'polkit')
optdepends=('paru: AUR updates and builds'
            'flatpak: Flatpak applications'
            'translate-shell: translation of Arch news'
            'git: building previous AUR versions'
            'base-devel: building AUR packages'
            'limine-mkinitcpio-hook: choosing the default kernel in Limine')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

check() {
  cd "$pkgname-$pkgver"
  python -m unittest discover -s tests -t .
}

package() {
  cd "$pkgname-$pkgver"
  make install DESTDIR="$pkgdir" PREFIX=/usr
}
